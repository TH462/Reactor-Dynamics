# OS / editor cruft
.DS_Store
Thumbs.db
*~
.idea/
.vscode/
*.swp

# Logs / temp
*.log
.cache/
tmp/

# Node (only if a dev static server / tooling is ever added; v1 has no build step)
node_modules/

# Vercel CLI link folder (project IDs; created by `vercel link`)
.vercel/

# Saved simulation states downloaded during manual testing
*.save.json
exports/

# Portable single-file builds from tools/make_portable.js — a ~2.5 MB generated
# artifact rebuilt from ui/shell.html in one command, so committing it would only
# create a second copy of the whole runtime that can silently fall out of date.
# test/run_portable.js fails if this line goes missing.
dist/

# Diagnostic JSON — session-diagnosis exports (Dev tab) and regenerated result
# dumps (behavior_results.json, ops_results.json). Kept out of the public repo;
# the curated Diagnostic/*.md reports ARE tracked and published.
Diagnostic/*.json
# Generated by test/audit_manual_controls.js (manual-run harness), same class.
Diagnostic/manual-audit.txt

# Internal working material — kept local, not published to the public repo.
# (No secrets; handoff drafts + design imports.) Untracked 2026-07-24 in prep
# for going public.
inbox/

# NOTE: CLAUDE.md is TRACKED (2026-07-29). It was ignored here until a `git worktree`
# gave a second agent a checkout with no orientation document at all, and the copy made
# to fix that immediately became a second source of truth. Tracking it buys version
# history for the instructions (so a rule that turns out to be wrong can be dated),
# propagation to every worktree, and a backup. It contains no secrets; it will be
# visible when the repo goes public, which is normal for the file.

# Personal go-public checklist — local only, not published
GO_PUBLIC_CHECKLIST.md

# Claude Code local settings (machine-specific; shared settings.json may be tracked)
.claude/settings.local.json

# Local harness / IDE artifacts (not part of the sim)
mcps/
terminals/

# Generated at deploy by site/make_download.js (see #258): the offline zip is built
# from the commit being deployed, so a committed copy could only ever be stale.
download/
