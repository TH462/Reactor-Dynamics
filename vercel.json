{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node site/stamp_version.js && node site/make_download.js && node site/build_site.js",
  "outputDirectory": "dist-site",
  "redirects": [
    { "source": "/sim", "destination": "/ui/shell.html?engine=pwr", "permanent": false }
  ],
  "git": {
    "deploymentEnabled": {
      "workbench": false,
      "backshop": false
    }
  }
}
